import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @afs,
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/async/process",
  "moonbitlang/core/cmp",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
  "dowdiness/js_engine/tooling/path_utils",
}

supported_targets = "+native"

// The 20260819 toolchain flags cleanup-only catch/rethrow paths. Keep the
// existing subprocess cleanup behavior until those paths migrate to errdefer.

warnings = "-92"
