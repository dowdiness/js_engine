///|
test "unicode parser filters properties and coalesces adjacent ranges" {
  let text =
    #|0041..005A ; ID_Start # Lu
    #|0061 ; ID_Start
    #|0062 ; ID_Start
    #|0030 ; ID_Continue
    #|0031..0032 ; ID_Continue
    #|00AA ; Other_Property
  let start = parse_unicode_property(text, "ID_Start")
  inspect(start.length(), content="2")
  assert_eq(start[0].0, 0x41)
  assert_eq(start[0].1, 0x5A)
  assert_eq(start[1].0, 0x61)
  assert_eq(start[1].1, 0x62)
  let part = parse_unicode_property(text, "ID_Continue")
  inspect(part.length(), content="1")
  assert_eq(part[0].0, 0x30)
  assert_eq(part[0].1, 0x32)
}

///|
test "unicode emitter preserves deterministic MoonBit table shape" {
  let tables : Map[String, Array[(Int, Int)]] = Map([])
  tables["ID_Start"] = [(0x41, 0x5A)]
  tables["ID_Continue"] = [(0x30, 0x39), (0x41, 0x5A)]
  let output = emit_unicode_tables("17.0.0", tables)
  assert_true(
    output.has_prefix(
      "// AUTOGENERATED by make unicode-tables — do not edit by hand.\n",
    ),
  )
  assert_true(
    output.contains(
      "/// 1 ranges, sorted and coalesced.\nlet id_start_ranges : Array[(Int, Int)] = [\n  (0x0041, 0x005A),\n]",
    ),
  )
  assert_true(
    output.contains(
      "/// 2 ranges, sorted and coalesced.\nlet id_continue_ranges : Array[(Int, Int)] = [\n  (0x0030, 0x0039),\n  (0x0041, 0x005A),\n]",
    ),
  )
  assert_true(output.contains("fn is_id_continue(cp : Int) -> Bool"))
  assert_true(output.has_suffix("}\n"))
}

///|
test "case-fold parser keeps only Unicode simple/common mappings" {
  let text =
    #|0041; C; 0061; # LATIN CAPITAL LETTER A
    #|00DF; F; 0073 0073; # full mapping, excluded
    #|1E9E; S; 00DF; # simple mapping
    #|0130; T; 0069; # Turkic mapping, excluded
  let mappings = parse_simple_case_folding(text)
  json_inspect(mappings, content=[[65, 97], [7838, 223]])
}

///|
test "case-fold emitter produces deterministic forward and inverse lookups" {
  let output = emit_case_folding_table("17.0.0", [
    (0x53, 0x73),
    (0x17F, 0x73),
    (0x212A, 0x6B),
  ])
  assert_true(output.contains("// Source: CaseFolding.txt @ Unicode 17.0.0"))
  assert_true(
    output.contains(
      "let unicode_simple_fold_mappings : Array[(Int, Int)] = [\n  (0x0053, 0x0073),\n  (0x017F, 0x0073),\n  (0x212A, 0x006B),\n]",
    ),
  )
  assert_true(
    output.contains(
      "let unicode_simple_fold_inverse : Array[(Int, Int)] = [\n  (0x006B, 0x212A),\n  (0x0073, 0x0053),\n  (0x0073, 0x017F),\n]",
    ),
  )
  assert_true(output.contains("fn unicode_simple_fold(cp : Int) -> Int"))
  assert_true(output.contains("fn unicode_simple_fold_equivalent_in_range("))
}
